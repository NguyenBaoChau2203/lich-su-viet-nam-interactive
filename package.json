    "agent:check": "node scripts/agent/validate-setup.mjs",
    "agent:setup": "node scripts/agent/setup.mjs",
    "agent:status": "node scripts/agent/codegraph.mjs status",
    "agent:sync": "node scripts/agent/codegraph.mjs sync",
    "agent:index": "node scripts/agent/codegraph.mjs rebuild",
    "agent:doctor": "node scripts/agent/doctor.mjs",
    "history:data:check": "vitest run tests/unit/content-validation.test.ts tests/unit/exam-bank-content.test.ts",
    "verify": "pnpm agent:check && pnpm history:data:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@payos/node": "2.0.5",
