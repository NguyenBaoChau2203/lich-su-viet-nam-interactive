* text=auto

*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.geojson text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.docx binary

# Keep the new checksum-pinned province pipeline/artifact identical on checkout.
/scripts/province-boundaries/*.py text eol=lf
/public/maps/history-vietnam-province-boundaries.geojson text eol=lf

# Keep the checksum-recorded bounded content import identical on Windows/Linux.
/supabase/seed-vietnam-timeline-2026-10-25.sql text eol=lf
/supabase/content/timeline-review-2026-10-26/publish-reviewed.sql text eol=lf
/supabase/content/timeline-review-2026-10-26/update-public-source-citations.sql text eol=lf

# Preserve audited local-hero SQL hashes on Windows and Linux checkouts.
/supabase/content/local-heroes/**/*.sql text eol=lf
/supabase/content/heritage-sites/**/*.sql text eol=lf
/supabase/migrations/20261031000001_local_hero_catalog.sql text eol=lf
/supabase/migrations/20261101000000_heritage_sites.sql text eol=lf
/supabase/releases/local-heroes-20261027/supabase/migrations/*.sql text eol=lf
# The captured dump has mixed newlines inside function bodies and a pinned byte hash.
# Keep its source formatting rather than rewriting the adopted historical snapshot.
/supabase/releases/local-heroes-20261027/supabase/migrations/*_system_public_baseline.sql -text whitespace=-trailing-space,-blank-at-eof

# Git for Windows must execute these through Git Bash without CRLF corruption.
/.githooks/* text eol=lf
