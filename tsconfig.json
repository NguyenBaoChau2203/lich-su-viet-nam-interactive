{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-local-heroes-admin/types/**/*.ts",
    ".next-local-heroes-admin/dev/types/**/*.ts",
    ".next-local-heroes/types/**/*.ts",
    ".next-local-heroes/dev/types/**/*.ts",
    ".next-explorer-map-journey/types/**/*.ts",
    ".next-explorer-map-journey/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "output",
    "outputs",
    ".codex-tmp",
    ".task-reports"
  ]
}
