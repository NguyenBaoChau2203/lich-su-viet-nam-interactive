{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.3.0"
  ],
  "permission": {
    "skill": {
      "*": "allow"
    },
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git push *--force*": "deny",
      "git reset --hard*": "deny",
      "git clean -*": "deny",
      "git checkout -- *": "deny",
      "Get-Content .env*": "deny",
      "type .env*": "deny",
      "rm -rf /*": "deny"
    }
  }
}
