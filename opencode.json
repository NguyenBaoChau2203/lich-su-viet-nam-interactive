{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.3.0"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.9.0",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git push *--force*": "deny",
      "git reset --hard*": "deny",
      "git clean -*": "deny",
      "git checkout -- *": "deny",
      "Get-Content .env*": "deny",
      "type .env*": "deny",
      "rm -rf /*": "deny"
    }
  }
}
