# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/output/
/outputs/
/.review-render*/
/.playwright-cli/

# next.js
/.next/
/.next-local-heroes/
/.next-local-heroes-admin/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.codex-tmp/
/.task-reports/
/.codex/config.toml
/.claude/settings.local.json
/CLAUDE.local.md
/.mcp.json

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Office temporary lock files
~$*.docx

# Imported application generated assets and Supabase CLI cache
/public/vendor/
/supabase/.temp/
/.vitest/

# Offline province builder test bytecode
/scripts/province-boundaries/__pycache__/

# Local media scratch and depth tool
/.media-work/
/.depth-tool/
